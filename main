


#include <Wire.h>
#include <LiquidCrystal_I2C.h>


// NOTAS MÚSICAIS NECESSÁRIAS PARA O TOQUE
#define NOTE_E5  659
#define NOTE_D5  587
#define NOTE_FS4 370
#define NOTE_GS4 415
#define NOTE_CS5 554
#define NOTE_B4  494
#define NOTE_D4  294
#define NOTE_E4  330
#define NOTE_A4  440
#define NOTE_CS4 277

int buzzer = 0;  
int botao = 4;   

// pinos I2C do display no ESP32-C3 Super Mini
#define SDA_PIN 8
#define SCL_PIN 9

LiquidCrystal_I2C lcd(0x27, 16, 2);

int tempo = 180;

//Lista com o toque da Nokia
int melody[] = {
  NOTE_E5, 8, NOTE_D5, 8, NOTE_FS4, 4, NOTE_GS4, 4, 
  NOTE_CS5, 8, NOTE_B4, 8, NOTE_D4, 4, NOTE_E4, 4, 
  NOTE_B4, 8, NOTE_A4, 8, NOTE_CS4, 4, NOTE_E4, 4,
  NOTE_A4, 2, 
};

int notes = sizeof(melody) / sizeof(melody[0]) / 2;
int wholenote = (60000 * 4) / tempo;

// -----------------------------------------------------------------------
// Toca a melodia completa da Nokia Tune uma vez
// -----------------------------------------------------------------------
void toca_Nokia() {
  for (int thisNote = 0; thisNote < notes * 2; thisNote += 2) {
    int divider = melody[thisNote + 1];
    int noteDuration;

    if (divider > 0) {
      noteDuration = wholenote / divider;
    } else {
      noteDuration = wholenote / abs(divider);
      noteDuration *= 1.5;
    }

    tone(buzzer, melody[thisNote], noteDuration * 0.9);
    delay(noteDuration);
    noTone(buzzer);
  }
}

// -----------------------------------------------------------------------
// Escreve duas linhas no display
// -----------------------------------------------------------------------
void mostra_visor(String linha1, String linha2 = "") {
  lcd.backlight();
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print(linha1);
  if (linha2 != "") {
    lcd.setCursor(0, 1);
    lcd.print(linha2);
  }
}


void desliga_visor() {
  lcd.clear();
  lcd.noBacklight();
}

void setup() {
  pinMode(botao, INPUT_PULLUP);

  Wire.begin(SDA_PIN, SCL_PIN);
  lcd.init();

  desliga_visor(); 
}

void loop() {
  if (digitalRead(botao) == LOW) {
    mostra_visor("Ligacao", "Julio");
    toca_Nokia();
    desliga_visor();
  }
}
