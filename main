#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

// NOTAS MUSICAIS NECESSÁRIAS PARA O TOQUE
#define NOTE_E5  659
#define NOTE_D5  587
#define NOTE_FS4 370
#define NOTE_GS4 415
#define NOTE_CS5 554
#define NOTE_B4  494
#define NOTE_D4  294
#define NOTE_E4  330
#define NOTE_A4  440
#define NOTE_CS4 277

int buzzer = 21;  
int botao = 0;   

// Pinos I2C do display no ESP32-C3 Super Mini
#define SDA_PIN 8
#define SCL_PIN 9

// Configurações do Display OLED SSD1306
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, -1);

int tempo = 180;

// Lista com o toque da Nokia
int melody[] = {
  NOTE_E5, 8, NOTE_D5, 8, NOTE_FS4, 4, NOTE_GS4, 4, 
  NOTE_CS5, 8, NOTE_B4, 8, NOTE_D4, 4, NOTE_E4, 4, 
  NOTE_B4, 8, NOTE_A4, 8, NOTE_CS4, 4, NOTE_E4, 4,
  NOTE_A4, 2, 
};

int notes = sizeof(melody) / sizeof(melody[0]) / 2;
int wholenote = (60000 * 4) / tempo;

// -----------------------------------------------------------------------
// Toca a melodia completa da Nokia Tune uma vez
// -----------------------------------------------------------------------
void toca_Nokia() {
  for (int thisNote = 0; thisNote < notes * 2; thisNote += 2) {
    int divider = melody[thisNote + 1];
    int noteDuration;

    if (divider > 0) {
      noteDuration = wholenote / divider;
    } else {
      noteDuration = wholenote / abs(divider);
      noteDuration *= 1.5;
    }

    tone(buzzer, melody[thisNote], noteDuration * 0.9);
    delay(noteDuration);
    noTone(buzzer);
  }
}

// -----------------------------------------------------------------------
// Escreve duas linhas no display OLED
// -----------------------------------------------------------------------
void mostra_visor(String linha1, String linha2 = "") {
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  
  // Exibe a primeira linha (Texto de tamanho médio)
  display.setTextSize(2);
  display.setCursor(0, 10);
  display.println(linha1);
  
  // Exibe a segunda linha se ela existir
  if (linha2 != "") {
    display.setTextSize(2);
    display.setCursor(0, 35);
    display.println(linha2);
  }
  
  display.display();
}

// -----------------------------------------------------------------------
// Limpa e desliga visualmente o visor OLED
// -----------------------------------------------------------------------
void desliga_visor() {
  display.clearDisplay();
  display.display();
}

void setup() {
  pinMode(botao, INPUT_PULLUP);

  // Inicializa o barramento I2C com os pinos do ESP32-C3 Super Mini
  Wire.begin(SDA_PIN, SCL_PIN);

  // Inicializa o display OLED no endereço 0x3C
  if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    // Se falhar, o código trava aqui para avisar que há um erro de hardware
    for(;;); 
  }

  desliga_visor(); 
}

void loop() {
  if (digitalRead(botao) == LOW) {
    mostra_visor("Ligacao", "Julio");
    toca_Nokia();
    desliga_visor();
  }
}
